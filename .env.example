# Configurazione Firebase per il modulo di contatto.
# Copia questo file in `.env` e inserisci i valori reali.
#
# Dove trovarli: Firebase Console (https://console.firebase.google.com)
#   → progetto "tecnoworld2-650b1"
#   → Impostazioni progetto (ingranaggio) → Generali → Le tue app
#   → sezione "SDK setup and configuration" (se non esiste un'app web, creane una).
#
# NOTA: `.env` è nel .gitignore e non va committato.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tecnoworld2-650b1.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tecnoworld2-650b1
VITE_FIREBASE_STORAGE_BUCKET=tecnoworld2-650b1.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
